# Supabase 대시보드 > Project Settings > API Keys 에서 복사한다
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# 내 공간에 들어올 수 있는 단 한 사람. GitHub 계정의 기본(primary) 이메일과 같아야 한다.
OWNER_EMAIL=you@example.com

# KU LMS+ 확장 프로그램의 ID. chrome://extensions 에서 확장 카드에 적힌 32글자.
# 이 확장이 보내는 LMS 일정만 /api/lms-sync 가 받는다.
LMS_EXTENSION_ID=abcdefghijklmnopabcdefghijklmnop

# 공부 공간에서 PDF 페이지마다 해설을 쓰는 OpenAI API. 키는 서버에서만 쓴다.
OPENAI_API_KEY=sk-...
# 비우면 gpt-6-luna. 해설이 아쉬우면 gpt-6.1-sol (약 20배 비싸다).
OPENAI_MODEL=
# 추론 모델의 생각 깊이. 비우면 모델 기본값 (none, low, medium, high ...)
OPENAI_REASONING_EFFORT=
